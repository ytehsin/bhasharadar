# Copy to .env and fill in only what you need. Everything is optional —
# the app works with zero keys using the free keyless sources.
# You can also enter keys in the app (Settings → API keys); they are stored encrypted.

# --- General ---
BR_HOST=127.0.0.1
BR_PORT=8000
# Shown to APIs in the User-Agent so they can contact you if needed (recommended)
BR_CONTACT_EMAIL=

# --- Adzuna (free registration: https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble (free key on request: https://jooble.org/api/about) ---
JOOBLE_API_KEY=

# --- USAJOBS (US federal jobs; most need US citizenship: https://developer.usajobs.gov/) ---
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- The Muse (optional key only raises rate limits) ---
THEMUSE_API_KEY=

# --- Email sending option A: SMTP with an app password ---
# Gmail: enable 2-step verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# --- Email sending option B: Gmail API via your own OAuth client ---
# Redirect URI to register: http://127.0.0.1:8000/api/email/oauth/google/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
